# Discord application credentials.
# Never place real credentials in this file.
DISCORD_TOKEN=replace-with-development-token
DISCORD_CLIENT_ID=replace-with-client-id

# Optional during early development. Registering commands to one test guild is faster.
DISCORD_DEV_GUILD_ID=replace-with-development-guild-id

# Fruits website integration (not implemented in the starter).
FRUITS_API_BASE_URL=https://example.invalid/api
FRUITS_API_TOKEN=replace-with-development-api-token
FRUITS_WEBHOOK_SECRET=replace-with-development-webhook-secret
